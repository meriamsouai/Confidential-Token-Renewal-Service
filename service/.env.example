MASTER_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./ctrs.db
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DASHBOARD_URL=http://127.0.0.1:5173

# Optional legacy global PAT (fallback only; prefer per-user login)
# GITLAB_PAT=

# Optional GitLab OAuth (only if your admin creates an OAuth application)
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/gitlab/callback
# GITLAB_OAUTH_SCOPES=read_user api

# Preferred when OAuth apps are disabled (university GitLab): users sign in
# from the dashboard by pasting a Personal Access Token (api scope).
SESSION_SECRET=change-me-session-secret

# SMTP for token lifecycle emails (create / rotate / revoke / expiring soon)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ctrs@example.com
SMTP_TLS=true
