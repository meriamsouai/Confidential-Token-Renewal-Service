{
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 1500,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.search.rootFiles.include": [
    "**/PhDThesis_example.tex"
  ],
  "latex-workshop.message.badbox.show": "none",
  "latex-workshop.message.warning.show": true,
  "latex-workshop.message.error.show": true,
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex → bibtex → pdflatex × 2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "C:\\Users\\meria\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\pdflatex.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Users\\meria\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64;${env:PATH}"
      }
    },
    {
      "name": "bibtex",
      "command": "C:\\Users\\meria\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\bibtex.exe",
      "args": ["%DOCFILE%"],
      "env": {
        "PATH": "C:\\Users\\meria\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64;${env:PATH}"
      }
    }
  ]
}
